rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles & referral lookups & admin management
    match /users/{userId} {
      // Allow reading user profiles (needed for referral validation and admin panel overview)
      allow read: if true;

      // Allow creating user profiles
      allow create: if isOwner(userId) || isSignedIn() || true;

      // Allow updates (for referrals, reward points, and notification settings)
      allow update: if true;
      allow delete: if false;

      // User bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }

      // User referral rewards subcollection
      match /referrals/{refId} {
        allow read, write: if true;
      }
    }

    // Notifications broadcast & targeted push system
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // App configuration & dynamic media endpoints
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom adult videos & view tracking
    match /adult_videos/{videoId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
